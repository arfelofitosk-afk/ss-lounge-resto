<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SS Lounge Resto - Ternate</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            line-height: 1.6;
            color: #333;
        }
        header {
            background: linear-gradient(135deg, #1a365d, #2c5283);
            color: white;
            text-align: center;
            padding: 60px 20px;
        }
        header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }
        header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }
        section {
            padding: 50px 20px;
            max-width: 1000px;
            margin: 0 auto;
        }
        h2 {
            text-align: center;
            color: #1a365d;
            margin-bottom: 30px;
            font-size: 1.8rem;
        }
        .about-content {
            text-align: center;
            font-size: 1.1rem;
            color: #555;
        }
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }
        .menu-item {
            background: #f9f9f9;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0,0,0,0.08);
            transition: transform 0.3s;
        }
        .menu-item:hover {
            transform: translateY(-5px);
        }
        .menu-item h3 {
            color: #1a365d;
            margin-bottom: 10px;
        }
        .price {
            font-weight: bold;
            color: #b8860b;
            font-size: 1.1rem;
        }
        .info-box {
            background: #f0f4f8;
            padding: 30px;
            border-radius: 12px;
            text-align: center;
        }
        .info-box p {
            margin: 10px 0;
            font-size: 1.05rem;
        }
        .btn {
            display: inline-block;
            background: #25d366;
            color: white;
            padding: 14px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.1rem;
            margin-top: 20px;
            transition: background 0.3s;
        }
        .btn:hover {
            background: #1da851;
        }
        footer {
            background: #1a365d;
            color: white;
            text-align: center;
            padding: 25px;
            font-size: 0.95rem;
        }
    </style>
</head>
<body>

<header>
    <h1>SS Lounge Resto</h1>
